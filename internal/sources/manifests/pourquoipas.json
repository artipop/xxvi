{
  "name": "pourquoipas",
  "title": "Pourquoi Pas?: колонка доски",
  "kind": "mcp",
  "command": "{{.Config.binary}}",
  "args": ["mcp", "feed"],
  "env": {
    "POURQUOIPAS_URL": "{{if eq .Config.where \"server\"}}{{.Config.url}}{{end}}"
  },
  "tokenEnv": "POURQUOIPAS_FEED_TOKEN",
  "auth": {"type": "token", "optional": true},
  "fields": [
    {
      "key": "board", "title": "Доска",
      "options": {"tool": "list_boards", "at": "boards", "value": "{{.title}}"}
    },
    {
      "key": "column", "title": "Колонка (пусто — вся доска)",
      "options": {
        "tool": "list_columns", "arguments": {"board": "{{.Config.board}}"},
        "at": "columns", "value": "{{.name}}", "dependsOn": ["board"]
      }
    },
    {"key": "where", "title": "Где работает Pourquoi Pas?", "type": "select", "values": ["local", "server"], "default": "local"},
    {"key": "binary", "title": "Где лежит Pourquoi Pas?", "default": "/Applications/pourquoipas.app/Contents/MacOS/pourquoipas"},
    {
      "key": "url", "title": "Адрес сервера Pourquoi Pas?",
      "showWhen": {"key": "where", "value": "server"}
    }
  ],
  "mcp": {
    "tool": "list_column_cards",
    "arguments": {
      "board": "{{.Config.board}}",
      "column": "{{.Config.column}}"
    },
    "itemsAt": "cards",
    "item": {
      "id": "{{.id}}",
      "version": "{{.updated}}",
      "title": "{{.title}}",
      "body": "{{range $name, $value := .properties}}{{$name}}: {{$value}}\n{{end}}",
      "url": "{{.url}}",
      "labels": ["{{.column}}"]
    }
  }
}
