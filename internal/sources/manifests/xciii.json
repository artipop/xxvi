{
  "name": "xciii",
  "title": "XCIII: колонка доски",
  "kind": "mcp",
  "command": "{{.Config.binary}}",
  "args": ["mcp", "feed"],
  "env": {
    "XCIII_URL": "{{.Config.url}}"
  },
  "tokenEnv": "XCIII_FEED_TOKEN",
  "auth": {"type": "token", "optional": true},
  "fields": [
    {
      "key": "board", "title": "Доска",
      "options": {"tool": "list_boards", "at": "boards", "value": "{{.title}}"}
    },
    {
      "key": "column", "title": "Колонка (пусто — вся доска)",
      "options": {
        "tool": "list_columns", "arguments": {"board": "{{.Config.board}}"},
        "at": "columns", "value": "{{.name}}", "dependsOn": ["board"]
      }
    },
    {"key": "binary", "title": "Где лежит XCIII", "default": "/Applications/XCIII.app/Contents/MacOS/XCIII"},
    {"key": "url", "title": "Адрес сервера XCIII (пусто — приложение на этой машине)"}
  ],
  "mcp": {
    "tool": "list_column_cards",
    "arguments": {
      "board": "{{.Config.board}}",
      "column": "{{.Config.column}}"
    },
    "itemsAt": "cards",
    "item": {
      "id": "{{.id}}",
      "version": "{{.updated}}",
      "title": "{{.title}}",
      "body": "{{range $name, $value := .properties}}{{$name}}: {{$value}}\n{{end}}",
      "url": "{{.url}}",
      "labels": ["{{.column}}"]
    }
  }
}
