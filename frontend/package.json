    "marked": "18.0.14",
    "solid-js": "2.0.0-rc.11"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
